# Canonical public origin; mandatory in production (no trailing path)
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
# Server only; used by data access and the isolated server-side password-auth client.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
EVERFLOW_API_KEY=
CRON_SECRET=
# 32 random bytes, Base64 or 64-char hex (for example: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=
ALLOW_LEGACY_ADMIN=false
# Only used when ALLOW_LEGACY_ADMIN=true during a temporary migration
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SESSION_SECRET=
